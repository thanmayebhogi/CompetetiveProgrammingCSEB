import java.io.*;
import java.util.*;

public class Solution {

    public static void bucketSort(double[] arr) {
        int n = arr.length;
        if (n <= 0) return;

        // Find maximum value to handle inputs >= 1
        double maxVal = arr[0];
        for (int i = 1; i < n; i++) {
            if (arr[i] > maxVal) {
                maxVal = arr[i];
            }
        }

        // Create buckets
        ArrayList<Double>[] buckets = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            buckets[i] = new ArrayList<Double>();
        }

        // Distribute elements into buckets
        for (int i = 0; i < n; i++) {
            int bucketIndex;
            if (maxVal < 1.0) {
                bucketIndex = (int) (arr[i] * n);
            } else {
                bucketIndex = (int) ((arr[i] / (maxVal + 1)) * n);
            }
            buckets[bucketIndex].add(arr[i]);
        }

        // Sort individual buckets
        for (int i = 0; i < n; i++) {
            Collections.sort(buckets[i]);
        }

        // Concatenate all buckets back into arr[]
        int index = 0;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < buckets[i].size(); j++) {
                arr[index++] = buckets[i].get(j);
            }
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        
        int n = sc.nextInt();
        double[] arr = new double[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextDouble();
        }

        bucketSort(arr);

        for (int i = 0; i < n; i++) {
            // Check if output needs integer printing or 2-decimal formatting
            if (arr[i] == (long) arr[i]) {
                System.out.print((long) arr[i] + (i == n - 1 ? "" : " "));
            } else {
                System.out.printf(Locale.US, "%.2f" + (i == n - 1 ? "" : " "), arr[i]);
            }
        }
        sc.close();
    }
}
